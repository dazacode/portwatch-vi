# All optional. YouTube and Rumble work without keys. Twitch and Kick are off until theirs are set.

# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Fallback for when YouTube blocks the keyless reads from your host.
# https://console.cloud.google.com, with "YouTube Data API v3" enabled
YOUTUBE_API_KEY=

# https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Makes commits on the front page a minute old instead of ten. A fine-grained token with public
# read-only access is enough: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Any long random text, the same here and in the GitHub secret of this name. Issues live challenges.
CHALLENGE_SECRET=

# Only if the site's address isn't Vercel's production domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional news sources for the harvester. Reddit works read-only without keys until it blocks
# the runner; X needs a paid bearer token.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# X_BEARER_TOKEN=
