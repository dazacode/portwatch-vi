{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "viportlive-timer",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  // It has nothing to answer, so it gets no address.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "REPO": "dazacode/portwatch-vi" },
  "observability": { "enabled": true }
  // The secret GH_TOKEN is a fine-grained GitHub token for this repository: Actions, read and write.
}
